# Copie para .env e preencha. Nunca faça commit do .env.
MLSTUDIO_HOME=./workspace
MLSTUDIO_DEMO=1
# Conector interno Power BI
MLSTUDIO_INTERNAL_CONNECTOR=
MLSTUDIO_INTERNAL_CONNECTOR_PATH=
MLSTUDIO_INTERNAL_CONNECTOR_KWARGS=
MLSTUDIO_INTERNAL_CONNECTOR_METHODS=
# API REST oficial do Power BI (service principal)
PBI_TENANT_ID=
PBI_CLIENT_ID=
PBI_CLIENT_SECRET=
# Assistente com IA (opcional)
ANTHROPIC_API_KEY=
MLSTUDIO_CHAT_MODEL=claude-opus-5-5
MLSTUDIO_CHAT_EFFORT=medium
